{
  "name": "atlas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src index.html vite.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.edge.json",
    "theme": "node scripts/generate-theme.mjs",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "audit:publish": "node scripts/audit-publish.mjs",
    "check:pages": "node scripts/check-pages-build.mjs",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
